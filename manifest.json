{
  "manifest_version": 3,
  "name": "Carona Conecta",
  "version": "0.2.1",
  "description": "Monta rotas com conexões entre caronas do BlaBlaCar. Projeto independente, não afiliado ao BlaBlaCar.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://www.blablacar.com.br/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Carona Conecta", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } }
}
